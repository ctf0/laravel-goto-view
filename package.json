{
    "name": "laravel-goto-view",
    "displayName": "Laravel Goto View",
    "description": "Quick jump to view",
    "version": "0.7.7",
    "publisher": "ctf0",
    "engines": {
        "vscode": "^1.110.0"
    },
    "icon": "images/logo.png",
    "repository": "https://github.com/ctf0/laravel-goto-view",
    "categories": [
        "Other"
    ],
    "keywords": [
        "PHP",
        "Laravel",
        "goto",
        "file navigation"
    ],
    "activationEvents": [
        "onLanguage:php",
        "onLanguage:blade",
        "onStartupFinished"
    ],
    "contributes": {
        "commands": [
            {
                "command": "lgtv.copyPath",
                "title": "Laravel Goto View: Copy File Path"
            },
            {
                "command": "lgtv.openPath",
                "title": "Laravel Goto View: Open File From Path"
            },
            {
                "command": "lgtv.createFileFromText",
                "title": "Laravel Goto View: Create File From Text"
            }
        ],
        "menus": {
            "commandPalette": [
                {
                    "command": "lgtv.copyPath",
                    "when": "editorLangId == blade"
                },
                {
                    "command": "lgtv.openPath",
                    "when": "!activeEditor || editorLangId =~ /(php|blade)/"
                },
                {
                    "command": "lgtv.createFileFromText",
                    "when": "false"
                }
            ]
        },
        "configuration": {
            "type": "object",
            "title": "Laravel Goto View",
            "properties": {
                "laravelGotoView.bladeMethods": {
                    "type": "array",
                    "default": [
                        "@include",
                        "@extends",
                        "@component",
                        "@each"
                    ],
                    "items": {
                        "type": "string"
                    },
                    "minItems": 1,
                    "uniqueItems": true,
                    "description": "methods to search for in blade"
                },
                "laravelGotoView.phpMethods": {
                    "type": "array",
                    "default": [
                        "(?<!Route::)view",
                        "view()->composer",
                        "links",
                        "template",
                        "markdown",
                        "defaultView",
                        "View::composer",
                        "View::creator"
                    ],
                    "items": {
                        "type": "string"
                    },
                    "minItems": 1,
                    "uniqueItems": true,
                    "description": "methods to search for in php"
                },
                "laravelGotoView.viewShareMethods": {
                    "type": "array",
                    "default": [
                        "View::share",
                        "$view->with"
                    ],
                    "items": {
                        "type": "string"
                    },
                    "minItems": 1,
                    "uniqueItems": true,
                    "description": "methods to search for viewShare variables"
                },
                "laravelGotoView.viewShareVariablePrefix": {
                    "type": "string",
                    "default": "_",
                    "example": "vs__",
                    "markdownDescription": "viewShare variable prefix"
                },
                "laravelGotoView.openPathCodelens": {
                    "type": "array",
                    "default": [
                        "[vV]iew\\(\\[?$"
                    ],
                    "items": {
                        "type": "string"
                    },
                    "uniqueItems": true,
                    "description": "text regex to show ('lgtv.openPath' command) code lens above"
                },
                "laravelGotoView.showCodeLens": {
                    "type": "boolean",
                    "default": true,
                    "description": "enable code lenses"
                },
                "laravelGotoView.similarCallCodeLens": {
                    "type": "string",
                    "default": "$(loading~spin)‎ show files with similar call (#)",
                    "markdownDescription": "codelens command text\n\nrequire `#laravelGotoView.showCodeLens#`\n\n[$(icon-name)](https://microsoft.github.io/vscode-codicons/dist/codicon.html)\n\n\\# == placeholder for files length (remove it to disable this feature)"
                },
                "laravelGotoView.similarIncludeDirectives": {
                    "type": "array",
                    "default": [
                        "(@include|@extends|@component|@each|@yield|@section|@stack)\\(['\"]([^$*]*?)['\"]",
                        "<x-(?!slot\\b)[\\w:.-]+"
                    ],
                    "items": {
                        "type": "string"
                    },
                    "minItems": 1,
                    "uniqueItems": true,
                    "markdownDescription": "directives to add similar view includes code lens for\n\nrequire `#laravelGotoView.showCodeLens#`"
                },
                "laravelGotoView.similarIncludeFilesRegex": {
                    "type": "array",
                    "default": [
                        "resources/views/**/*blade*",
                        "modules/**/*blade*"
                    ],
                    "items": {
                        "type": "string"
                    },
                    "minItems": 1,
                    "uniqueItems": true,
                    "description": "which files to look for similar includes (path begin from root)"
                },
                "laravelGotoView.createViewIfNotFound": {
                    "type": "boolean",
                    "default": true,
                    "description": "auto create view if not found"
                },
                "laravelGotoView.activateViewAfterCreation": {
                    "type": "boolean",
                    "default": true,
                    "markdownDescription": "show/open the newly created view\n\nrequire `#laravelGotoView.createViewIfNotFound#`"
                },
                "laravelGotoView.copiedPathSurround": {
                    "type": "string",
                    "default": "@include('$ph')",
                    "description": "auto surround copied file path ($ph will be replaced with the actual file path)"
                },
                "laravelGotoView.copiedComponentPathSurround": {
                    "type": "string",
                    "default": "x-$ph",
                    "description": "auto surround copied component file path ($ph will be replaced with the actual file path)"
                },
                "laravelGotoView.viewDefaultValue": {
                    "type": "string",
                    "editPresentation": "multilineText",
                    "default": "@extends('layouts.app')\n\n@section('content')\n\n@endsection",
                    "markdownDescription": "text to be added for the newly created view (this will open the file in the background)\n\nrequire `#laravelGotoView.createViewIfNotFound#`"
                },
                "laravelGotoView.defaultPath": {
                    "type": "string",
                    "default": "/resources/views",
                    "markdownDescription": "laravel default view path from app root"
                },
                "laravelGotoView.vendorPath": {
                    "type": "array",
                    "default": [
                        "/modules/*/resources/views"
                    ],
                    "items": {
                        "type": "string"
                    },
                    "minItems": 1,
                    "uniqueItems": true,
                    "markdownDescription": "where to look for the view files path from app root\n\n(* will be replaced by [namespace](https://laravel.com/docs/8.x/packages#views))"
                }
            }
        }
    },
    "main": "./out/main",
    "scripts": {
        "vscode:prepublish": "npm run esbuild-base -- --pure:console.log --minify",
        "esbuild-base": "esbuild ./src/extension.ts --bundle --outfile=out/main.js --external:vscode --external:find-in --external:fs-extra --format=cjs --platform=node",
        "esbuild": "npm run esbuild-base -- --sourcemap",
        "esbuild-watch": "npm run esbuild-base -- --sourcemap --watch",
        "watch": "npm run esbuild"
    },
    "devDependencies": {
        "@types/glob": "^9.0.0",
        "@types/node": "^26.1.1",
        "@types/vscode": "^1.110.0",
        "esbuild": "^0.28.1",
        "typescript": "^7.0.2"
    },
    "dependencies": {
        "escape-string-regexp": "^5.0.0",
        "find-in": "^0.2.0",
        "fs-extra": "^11.3.6",
        "lodash.debounce": "^4.0.8",
        "pascalcase": "^2.0.0"
    }
}
